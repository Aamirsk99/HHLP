# Copy to .env and fill in.

# Claude (AI replies + lead scoring): https://console.anthropic.com
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
# low = fast and cheap chat replies; medium/high = more careful
AGENT_EFFORT=low

# WhatsApp Cloud API (Meta for Developers → your app → WhatsApp → API Setup)
# Leave WHATSAPP_TOKEN empty to run in dry-run mode (replies are printed, not sent).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any secret string; type the same one in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=hindivine-verify
# App settings → Basic → App secret (checks that webhooks really come from Meta)
WHATSAPP_APP_SECRET=
# Approved template for follow-ups after the 24-hour window (body may use {{1}} = lead name)
WHATSAPP_FOLLOWUP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# Follow-ups
FOLLOWUP_ENABLED=true
FOLLOWUP_MAX=3
BUSINESS_TZ=Asia/Kolkata
QUIET_START_HOUR=21
QUIET_END_HOUR=9

# Dashboard login (strongly recommended)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

PORT=3000
# DB_PATH=./data/leads.db
